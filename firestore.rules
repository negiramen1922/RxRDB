rules_version = '2';
// RxRDB（バベルTier表）用 Firestore ルール
// Firebase コンソール → Firestore Database → ルール に丸ごと貼り付けて「公開」
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function email() { return request.auth.token.email; }
    function isOwner() { return signedIn() && email() == "negiramen23@gmail.com"; }
    function isEditor() {
      return isOwner() || (signedIn() && exists(/databases/$(database)/documents/roles/$(email())));
    }

    // 公開データ（サイトが読む）: 誰でも読める / 編集者だけ書ける
    match /public/{doc} {
      allow read: if true;
      allow write: if isEditor();
    }

    // 編集用の行データ（1行1ドキュメント）
    match /tables/{t} {
      allow read, write: if isEditor();
      match /rows/{r} {
        allow read, write: if isEditor();
      }
    }

    // メンバー（編集者）: メールアドレスはオーナーだけが見られる（本人は自分の分だけ確認できる）
    match /roles/{e} {
      allow read: if isOwner() || (signedIn() && email() == e);
      allow write: if isOwner();
    }

    // メンバーの表示名（メールアドレスは持たない）。本人だけが書ける
    match /names/{uid} {
      allow read: if isEditor();
      allow write: if isEditor() && request.auth.uid == uid;
    }

    // 変更履歴: 自分の名前でだけ追加できる。書き換え不可
    match /log/{id} {
      allow read: if isEditor();
      allow create: if isEditor() && request.resource.data.by == request.auth.uid;
      allow update, delete: if isOwner();
    }

    // GitHub 連携のトークン（画像アップロード用）: メンバーだけが読める / オーナーだけが登録できる
    match /secrets/{d} {
      allow read: if isEditor();
      allow write: if isOwner();
    }

    // 「いま編集中」の表示
    match /editing/{uid} {
      allow read: if isEditor();
      allow write: if isEditor() && request.auth.uid == uid;
      allow delete: if isOwner();
    }

    // 不具合・ご要望フォーム: 誰でも送信できる（中身は編集者だけが読める）
    match /feedback/{id} {
      allow create: if request.resource.data.keys().hasOnly(["kind", "text", "contact", "page", "ua", "at", "status"])
        && request.resource.data.kind in ["bug", "request", "other"]
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000
        && request.resource.data.contact is string && request.resource.data.contact.size() <= 200
        && request.resource.data.page is string && request.resource.data.page.size() <= 100
        && request.resource.data.ua is string && request.resource.data.ua.size() <= 200
        && request.resource.data.status == "new"
        && request.resource.data.at == request.time;
      allow read, update, delete: if isEditor();
    }

    // テスターモードの記録（公開前の確認）: だれでも自分の分（推測できない長い ID）を作成・上書きできる。中身は編集者だけが読める
    // d は記録の JSON 文字列。chk は管理画面で付ける「対応済み」の印（テスターの送信では変えられない）
    match /testers/{id} {
      function okBody() {
        return request.resource.data.name is string && request.resource.data.name.size() <= 40
          && request.resource.data.d is string && request.resource.data.d.size() <= 200000
          && request.resource.data.ua is string && request.resource.data.ua.size() <= 200
          && request.resource.data.t == request.time;
      }
      allow read, delete: if isEditor();
      allow create: if id.size() >= 20 && id.size() <= 40
        && request.resource.data.keys().hasOnly(["name", "d", "ua", "v", "t"]) && okBody();
      allow update: if request.resource.data.keys().hasOnly(["name", "d", "ua", "v", "t", "chk"]) && okBody()
        && request.resource.data.get("chk", null) == resource.data.get("chk", null)
        && request.time > resource.data.t + duration.value(3, "s");
      allow update: if isEditor() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["chk"]);
    }

    // 一般ユーザーの記録（所持キャラ・自分用Tier表など。本人だけが読み書きできる。d は記録の JSON 文字列）
    match /users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(["d", "t", "v"])
        && request.resource.data.d is string && request.resource.data.d.size() <= 800000
        && request.resource.data.t == request.time
        && (resource == null || request.time > resource.data.t + duration.value(2, "s"));
    }

    // アクセス数（日別）: 2026-10-13 で記録を終了（Google アナリティクスで見る）。過去の分は編集者だけが読める
    match /stats/{day} {
      allow read: if isEditor();
    }
  }
}
